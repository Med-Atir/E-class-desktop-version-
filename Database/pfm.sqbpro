<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="pfm.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="2299"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="annonce" custom_title="0" dock_id="1" table="4,7:mainannonce"/><dock_state state="000000ff00000000fd00000001000000020000033b00000226fc0100000001fb000000160064006f0063006b00420072006f007700730065003101000000000000033b0000011800ffffff000002580000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="usrrs" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="29"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">CREATE TABLE user (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    nom TEXT NOT NULL,
    email TEXT NOT NULL UNIQUE,
    password TEXT NOT NULL,
    role TEXT NOT NULL, 
    date_creation DATETIME DEFAULT (datetime('now', 'localtime'))
);

CREATE TABLE classe (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    titre TEXT NOT NULL,
    code TEXT NOT NULL UNIQUE,
    description TEXT NOT NULL
);

CREATE TABLE classe_etudiant (
    classe_id INTEGER,
    etudiant_id INTEGER,
    date_inscription DATETIME DEFAULT (datetime('now', 'localtime')),
    PRIMARY KEY (classe_id, etudiant_id),
    FOREIGN KEY (classe_id) REFERENCES classe(id) ON DELETE CASCADE,
    FOREIGN KEY (etudiant_id) REFERENCES user(id) ON DELETE CASCADE
);

CREATE TABLE devoir (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    titre TEXT NOT NULL,
    consigne TEXT,
    chemin_fichier TEXT,
    id_prof INTEGER NOT NULL,
    id_classe INTEGER NOT NULL,
    date_poste DATETIME DEFAULT (datetime('now', 'localtime')),
    FOREIGN KEY (id_prof) REFERENCES user(id) ON DELETE CASCADE,
    FOREIGN KEY (id_classe) REFERENCES classe(id) ON DELETE CASCADE
);

CREATE TABLE annonce (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    titre TEXT NOT NULL,
    contenu TEXT NOT NULL,
    id_prof INTEGER NOT NULL,
    id_classe INTEGER NOT NULL,
    date_poste DATETIME DEFAULT (datetime('now', 'localtime')),
    FOREIGN KEY (id_prof) REFERENCES user(id) ON DELETE CASCADE,
    FOREIGN KEY (id_classe) REFERENCES classe(id) ON DELETE CASCADE
);

CREATE TABLE document (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    titre TEXT NOT NULL,
    chemin_fichier TEXT NOT NULL,
    id_classe INTEGER NOT NULL,
    date_upload DATETIME DEFAULT (datetime('now', 'localtime')),
    FOREIGN KEY (id_classe) REFERENCES classe(id) ON DELETE CASCADE
);

CREATE TABLE demande (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    status TEXT NOT NULL DEFAULT 'en_attente',
    id_etudiant INTEGER NOT NULL,
    id_classe INTEGER NOT NULL,
    date_demande DATETIME DEFAULT (datetime('now', 'localtime')),
    FOREIGN KEY (id_etudiant) REFERENCES user(id) ON DELETE CASCADE,
    FOREIGN KEY (id_classe) REFERENCES classe(id) ON DELETE CASCADE
);</sql><current_tab id="0"/></tab_sql></sqlb_project>
