   <string notr="true">QMainWindow {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #007bff, stop:1 #6610f2);
    font-family: 'Poppins', 'Segoe UI', sans-serif;
}

QLabel {
    color: white;
    background-color: transparent;
    qproperty-alignment: 'AlignHCenter | AlignVCenter';
}

QLabel#lblTitre {
    font-size: 26px;
    font-weight: bold;
    margin-bottom: 5px;
}

QLabel#lblSousTitre {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 30px;
}

QLineEdit {
    background-color: rgba(255, 255, 255, 0.95);
    color: #333333;
    border: 2px solid transparent;
    border-radius: 22px;
    padding: 12px 20px;
    font-size: 14px;
    min-width: 300px;
    max-width: 400px;
}

QLineEdit:focus {
    background-color: white;
    border: 2px solid #00c6ff;
}

QRadioButton {
    color: white;
    font-size: 15px;
    font-weight: bold;
    padding: 8px 15px;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 15px;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    background-color: transparent;
    border: 2px solid white;
}

QRadioButton::indicator:checked {
    background-color: #00c6ff;
    border: 2px solid white;
}

QPushButton {
    border-radius: 22px;
    padding: 12px 30px;
    font-size: 16px;
    font-weight: bold;
    min-width: 250px;
    max-width: 350px;
}

QPushButton#signup, QPushButton#btnLogin {
    background-color: white;
    color: #007bff;
    border: none;
}

QPushButton#signup:hover, QPushButton#btnLogin:hover {
    background-color: #f1f2f6;
    color: #0056b3;
}

QPushButton#login, QPushButton#btnCreateAcc {
    background-color: transparent;
    color: white;
    border: 2px solid white;
}

QPushButton#login:hover, QPushButton#btnCreateAcc:hover {
    background-color: rgba(255, 255, 255, 0.15);
}</string>
